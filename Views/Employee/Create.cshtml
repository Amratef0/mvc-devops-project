@model Employee

<h2>Create Employee</h2>

<form asp-action="SaveCreate" method="post">

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <br />

    <div>
        <label>Department</label>
        <input asp-for="Department" />
    </div>

    <br />

    <div>
        <label>Salary</label>
        <input asp-for="Salary" />
    </div>

    <br />

    <button type="submit">Save</button>
    <a asp-controller="Employee" asp-action="Index">Back</a>

</form>